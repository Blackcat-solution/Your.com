{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusrelay.dev/oacp/0.1/schemas/cart_intent.json",
  "title": "OACP Cart Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "intent_id", "merchant_id", "order_id", "currency", "amount_minor", "merchant_category", "merchant_manifest_sha256", "items", "expires_at"],
  "properties": {
    "protocol_version": {"const": "oacp/0.1"},
    "intent_id": {"type": "string", "format": "uuid"},
    "merchant_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "order_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "currency": {"type": "string", "pattern": "^[a-z]{3}$"},
    "amount_minor": {"type": "integer", "minimum": 1},
    "merchant_category": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "merchant_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["sku", "title", "quantity", "unit_amount_minor"], "properties": {"sku": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1, "maximum": 100}, "unit_amount_minor": {"type": "integer", "minimum": 0}}}},
    "expires_at": {"type": "string", "format": "date-time"},
    "user_signature": {"type": "string", "contentEncoding": "base64"}
  }
}

